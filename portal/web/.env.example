# Frontend Environment Configuration Template
# Copy this file to .env.{environment} (e.g., .env.development, .env.test)
# Vite automatically loads .env.{mode} based on --mode flag

# ============================================
# Environment
# ============================================
VITE_ENVIRONMENT=development

# ============================================
# API Configuration
# ============================================
# Backend API base URL (must include /api/v1 suffix)
VITE_API_BASE_URL=http://localhost:8000/api/v1
