# ─── Staging environment template ────────────────────────────────────────────
# This file is committed as a reference template only.
# Actual secret values are set in the Railway project's variable panel and
# injected at runtime; they must NEVER be stored in this file.
# ─────────────────────────────────────────────────────────────────────────────

ENVIRONMENT=staging

# Injected automatically by Railway when a PostgreSQL plugin is attached.
DATABASE_URL=${DATABASE_URL}

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Set as a Railway service variable - do not commit the real value.
SECRET_KEY=${SECRET_KEY}

# OANDA broker credentials - set as Railway service variables.
OANDA_API_KEY=${OANDA_API_KEY}
OANDA_ACCOUNT_ID=${OANDA_ACCOUNT_ID}

# Use the OANDA fxTrade Practice environment for staging; change to 'live'
# only after full production sign-off.
OANDA_ENV=practice

# ─── Data ingestion ───────────────────────────────────────────────────────────
INGESTION_ENABLED=true

# Seconds between market-data polling cycles.
INGESTION_POLL_INTERVAL=60

# Number of calendar days of historical candles to backfill on startup.
# 1825 = 5 years of data.
BACKFILL_DAYS=1825

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Add the Railway-assigned backend URL here if the frontend makes direct calls.
BACKEND_CORS_ORIGINS=https://agentfx.vercel.app,http://localhost:5173
