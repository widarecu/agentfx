# Environment Configuration Template
# Copy this file to .env.{environment} and fill in the values
# Supported environments: development, test, staging, production
#
# For Docker development (make docker-up):
#   - Environment variables are set in docker-compose.yml, not .env files
#   - OANDA credentials are read from your shell: export OANDA_API_KEY=...
#   - DATABASE_URL uses 'postgres' hostname (Docker service name) instead of 'localhost'

# ============================================
# Environment Settings
# ============================================
ENVIRONMENT=development
DEBUG=true
TESTING=false


# ============================================
# Database Configuration (PostgreSQL)
# ============================================
# For local development: postgresql://user:password@localhost:5432/agentfx_dev
# For Docker: postgresql://agentfx:agentfx@postgres:5432/agentfx
DATABASE_URL=postgresql://agentfx:agentfx@localhost:5432/agentfx_dev

# ============================================
# Security
# ============================================
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-with-a-secure-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ============================================
# CORS Configuration
# ============================================
# Comma-separated list of allowed origins
# IMPORTANT: Must include frontend origin (usually http://localhost:5173 for Vite)
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# ============================================
# OANDA API Configuration
# ============================================
# Get your API key from https://www.oanda.com/account/tpa/personal_token
# Use 'practice' for paper trading, 'live' for real trading
OANDA_ENV=practice
OANDA_API_KEY=your-oanda-api-key-here
OANDA_ACCOUNT_ID=your-oanda-account-id-here
OANDA_API_HOST=api-fxpractice.oanda.com
OANDA_STREAMING_HOST=stream-fxpractice.oanda.com

# ============================================
# Logging
# ============================================
LOG_LEVEL=INFO

# ============================================
# Candle Ingestion Worker
# ============================================
# Enable/disable the background ingestion worker
INGESTION_ENABLED=true
# Poll interval in seconds (default: 60)
INGESTION_POLL_INTERVAL=60
# Days of historical data to backfill (default: 7, set to 1825 for 5 years)
BACKFILL_DAYS=1825

# ============================================
# Candle Data Configuration
# ============================================
# Instruments to ingest (comma-separated)
CANDLE_INSTRUMENTS=EUR_USD,GBP_USD,USD_JPY,AUD_USD,USD_CHF,USD_CAD
# Granularities to ingest (comma-separated)
CANDLE_GRANULARITIES=M1,M5,M10,M30,H1,H4,H12,D,W,M
# Health check interval in seconds (gap detection/healing)
# Set to 0 to disable continuous health checks (only run at startup)
CANDLE_HEALTH_CHECK_INTERVAL=3600
