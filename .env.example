# Environment Configuration Template
# Copy this file to .env.{environment} and fill in the values
# Supported environments: development, test, uat, staging, production
#
# This is the tracked template of record: the real .env.* files are
# gitignored, so this is the only place the full config contract is visible.
#   - Every `env="..."` setting in src/agentfx/api/core/config.py has an
#     entry here (the ingestion knobs are described, deliberately not
#     assigned). `make check-env-example`, also run by the unit suite in
#     CI, fails when one is missing: add new settings here in the same PR.
#   - Active lines are safe as-is (fleet + integration flags off, secrets
#     empty) because `make dotenv` copies this file verbatim into a missing
#     .env.development. Commented `# VAR=` lines are documented but not set.
#
# For Docker (make docker-up PROFILE=dev|test|uat):
#   - The backend container loads .env.development / .env.test / .env.uat
#     via `env_file:` in docker-compose.yml, so credentials (OANDA, SMTP,
#     fleet keys) go in that file.
#   - docker-compose.yml's `environment:` block overrides DATABASE_URL
#     ('postgres' service hostname instead of 'localhost'),
#     BACKEND_CORS_ORIGINS and the ingestion knobs (see that section).
#   - Railway (staging/production) reads no .env file: set the same vars
#     in the Railway service-variables dashboard.

# ============================================
# Environment Settings
# ============================================
ENVIRONMENT=development
DEBUG=true
TESTING=false


# ============================================
# Database Configuration (PostgreSQL)
# ============================================
# For local development: postgresql://user:password@localhost:5432/agentfx_dev
# For Docker: postgresql://agentfx:agentfx@postgres:5432/agentfx
DATABASE_URL=postgresql://agentfx:agentfx@localhost:5432/agentfx_dev

# Test database: read by the integration suite (tests/integration/,
# run_tests.sh), so it only matters in .env.test. Values match the Docker
# `postgres-test` service (make docker-up PROFILE=test, host port 5433);
# config.py's defaults still assume a local Postgres on 5432.
TEST_DATABASE_URL=postgresql://test_user:test_password@localhost:5433/agentfx_test
TEST_DATABASE_HOST=localhost
TEST_DATABASE_PORT=5433
TEST_DATABASE_NAME=agentfx_test
TEST_DATABASE_USER=test_user
TEST_DATABASE_PASSWORD=test_password

# ============================================
# Security
# ============================================
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-with-a-secure-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Fernet key for at-rest encryption of user OANDA credentials (US-019).
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# REQUIRED in staging/production/UAT. Never reuse across environments.
FERNET_KEY=

# JWT signing algorithm (config.py field ALGORITHM, default HS256; leave
# it). Heads-up: config.py declares env="JWT_ALGORITHM", but
# pydantic-settings v2 ignores Field(env=...), so this name has NO effect
# today; the field is actually read from ALGORITHM. Kept commented until
# config.py is fixed.
# JWT_ALGORITHM=HS256

# ============================================
# CORS Configuration
# ============================================
# Comma-separated list of allowed origins
# IMPORTANT: Must include frontend origin (usually http://localhost:5173 for Vite)
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# ============================================
# OANDA API Configuration
# ============================================
# Get your API key from https://www.oanda.com/account/tpa/personal_token
# Use 'practice' for paper trading, 'live' for real trading
OANDA_ENV=practice
OANDA_API_KEY=your-oanda-api-key-here
OANDA_ACCOUNT_ID=your-oanda-account-id-here
OANDA_API_HOST=api-fxpractice.oanda.com
OANDA_STREAMING_HOST=stream-fxpractice.oanda.com

# ============================================
# Logging
# ============================================
LOG_LEVEL=INFO

# ============================================
# Candle Ingestion Worker
# ============================================
# INGESTION_ENABLED, BACKFILL_DAYS, CANDLE_INSTRUMENTS, and
# CANDLE_GRANULARITIES are intentionally NOT set here. They are governed
# by ONE source per execution surface (no shared file across surfaces):
#
#   1. pytest (host)        → forced false by tests/conftest.py
#                             (test-correctness invariant)
#   2. Local Docker dev/test → docker-compose.yml `environment:` block
#                             with `${VAR:-default}` shell substitution.
#                             Override at boot time, e.g.:
#                               make docker-up PROFILE=dev INGESTION_ENABLED=false
#                               CANDLE_INSTRUMENTS=EUR_USD CANDLE_GRANULARITIES=M1 \
#                                 make docker-up PROFILE=test INGESTION_ENABLED=true \
#                                                BACKFILL_DAYS=2190
#   3. Railway              → set in the Railway service-variables dashboard
#                             (image doesn't ship with .env files)
#
# Defaults baked into the Pydantic settings in
# `src/agentfx/api/core/config.py` apply when no env var is set on any
# surface. Putting these vars BACK into .env.{development,test} re-creates
# the shadow-confusion this layout was designed to eliminate — please don't.
# See CLAUDE.md → "Ingestion toggle: three-surface model" for the full
# rationale and command examples.

# Poll interval in seconds (default: 60)
INGESTION_POLL_INTERVAL=60

# Wilson UAT 2026-08-02: fold-anchored + bar-boundary ingestion.
# Two coupled timing knobs that determine how fresh candle data is by
# the time the paper runner evaluates a signal. Getting them wrong
# causes silent races → paper runner reads stale df → misses cross-
# event entries (see paper_runner.py Fix D history). Constraints:
#
#   INGESTION_ALIGNMENT_BUFFER_SECONDS < SIGNAL_TICK_OFFSET_SECONDS
#   SIGNAL_TICK_OFFSET_SECONDS > INGESTION_ALIGNMENT_BUFFER_SECONDS
#                                + observed ingestion cycle work (2-6s)
#
# Defaults align with observed OANDA behavior (bar available ~1s
# post-close). Timing budget for one M1 bar:
#   :00     bar closes
#   :03     ingester wakes (BUFFER=3)
#   :06-:09 ingester writes bar to DB (cycle work)
#   :10     signal tick fires (OFFSET=10)
#   :10.5   order placed → OANDA fill

# Seconds after each minute boundary to wake the ingestion loop.
# OANDA typically has closed bars available within ~1s of close;
# 3s buffer gives margin without wasted latency. Bump if OANDA's
# post-close latency ever grows.
INGESTION_ALIGNMENT_BUFFER_SECONDS=3

# Seconds after each granularity boundary to fire paper-run signal
# ticks. Must be > INGESTION_ALIGNMENT_BUFFER_SECONDS + typical
# ingestion cycle duration, so the just-closed bar is guaranteed to
# be in the DB when the runner evaluates.
SIGNAL_TICK_OFFSET_SECONDS=10

# Health check interval in seconds (gap detection/healing)
# Set to 0 to disable continuous health checks (only run at startup)
CANDLE_HEALTH_CHECK_INTERVAL=3600

# Days before re-checking a gap OANDA previously returned empty, in case
# OANDA has since backfilled it.
GAP_REVERIFY_DAYS=30

# Max gaps healed per instrument/granularity per health-check cycle.
MAX_GAPS_PER_HEALTH_CHECK=500

# ============================================
# Agent / Evolution Loop Configuration (v0.3.0)
# ============================================
# Anthropic API key powers the LLM hypothesis-injection step in the
# autonomous strategy evolution loop. Get one at:
#   https://console.anthropic.com/settings/keys
# Without it, evolution runs proceed without LLM injection (GA-only).
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Per-run LLM budget cap (USD). Default applied when a POST
# /api/v1/evolution-runs request body doesn't override it. Prod default
# is 5.00; lower in non-prod to limit accidental spend.
EVOLUTION_LLM_BUDGET_USD=5.00

# Anthropic model alias. Valid: claude-sonnet-4-6 (default — balanced),
# claude-haiku-4-5 (cheap diversity variant), claude-opus-4-7 (max
# capability — for correctness-critical runs only).
EVOLUTION_LLM_MODEL=claude-sonnet-4-6

# ============================================
# Nightly Evolution Cron (Railway only)
# ============================================
# These env vars are consumed by scripts/trigger_nightly_evolution.py,
# which is invoked by the Railway cron declared in railway.toml. They
# are NOT needed for local development — only set them on the deployed
# Railway service.
#
# AGENTFX_BASE_URL=https://agentfx-staging.up.railway.app
# CRON_SERVICE_TOKEN=<service-account JWT or API key>
# CRON_INSTRUMENTS=EUR_USD,GBP_USD
# CRON_GRANULARITY=M1
# CRON_DATA_YEARS=5
# CRON_LLM_BUDGET_USD=5.00

# ============================================
# Notifications — email via SMTP (Resend)
# ============================================
# Paper-run terminal + crash alerts and fleet agent emails go out over
# SMTP + STARTTLS. Empty SMTP_HOST (or empty EMAIL_TO) disables all
# outbound email: `_should_send` short-circuits before any network I/O,
# so the defaults below send nothing.
#
# Provider: Resend (AFX-77). SendGrid was replaced on 2026-11-04 after
# its trial expired.
#
# Resend setup (once per sending domain, e.g. plusfx.net):
#   1. Resend dashboard → Domains → Add Domain. Publish the SPF / DKIM /
#      Return-Path DNS records it lists and wait for "Verified".
#   2. Resend dashboard → API Keys → Create API Key with "Sending access",
#      restricted to that domain. Put it straight into the deployment's
#      secrets (Railway dashboard / .env.uat), never into this file.
#   3. Set on the deployment:
#        SMTP_HOST=smtp.resend.com
#        SMTP_PORT=587         # STARTTLS. Not 465: the sender always
#                              # calls starttls(), never implicit TLS.
#        SMTP_USER=resend      # the literal string "resend"
#        SMTP_PASSWORD=re_...  # the API key from step 2
#        EMAIL_FROM=alerts@<verified domain>
#        EMAIL_TO=<comma-separated recipients>
#
# EMAIL_FROM is required with Resend: when empty, the sender falls back
# to SMTP_USER, which for Resend is "resend", not a valid sender address.
# SMTP_PASSWORD is the API key: a secret, never log or commit it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# Master on/off. Defaults to true; only override to explicitly silence
# notifications without unsetting SMTP_HOST (e.g. a quiet weekend, a
# staging soak-test where the alerts would get noisy).
NOTIFICATIONS_ENABLED=true

# DEPRECATED — kept for rollback safety; not read by any current code.
# SLACK_WEBHOOK_URL=

# ============================================
# Agent Fleet (v0.8.x) — see planning/ROADMAP.md
# ============================================
# Master switch. When false the orchestrator lifespan hook is a no-op and
# no fleet agent (PM / QA / PE / Research) ever fires. Keep false in
# staging/production until Wilson approves the feat/agent-fleet → main
# merge (v0.8.3); .env.development / .env.uat may set true to see fleet
# behaviour locally.
AGENT_FLEET_ENABLED=false

# Platform email of the fleet operator (Wilson). PM-authored evolution
# runs are attributed to this user so they show up in the operator's
# RBAC-scoped listing. Empty = runs stay fleet-scoped (created_by=NULL),
# visible only to ADMINs via scope=all.
AGENT_FLEET_OWNER_EMAIL=

# Per-agent model routing (cost-tuned: Haiku for the PM daily brief,
# Sonnet for QA divergence reports + the Research digest, Opus for PE
# code work). Override to re-pin without a code change if a model is
# retired or repriced.
AGENT_PM_MODEL=claude-haiku-4-5
AGENT_QA_MODEL=claude-sonnet-5
AGENT_PE_MODEL=claude-opus-5
AGENT_RA_MODEL=claude-sonnet-5

# Fleet budget (USD). The daily cap is HARD: exceeding it skips the next
# scheduled run and emails Wilson. The monthly value is a soft trip-wire:
# one email alert, agents keep running until the daily cap kicks in.
AGENT_FLEET_DAILY_USD_CAP=2.00
AGENT_FLEET_MONTHLY_USD_ALERT=20.00

# ============================================
# PE Managed Agents workspace (v0.8.1 C.2 Phase 2)
# ============================================
# Flag off (default): every PE proposal stays on the email path. Flag on:
# HIGH-confidence proposals (and, via the Linear Agent webhook below,
# issues delegated to the PE in Linear) dispatch to a Managed Agents
# workspace that opens a PR against `feat/agent-fleet`. The real adapter
# needs the flag AND GITHUB_TOKEN AND all three resource IDs; with any
# of them missing, dispatch degrades to stub behaviour (no cost).
AGENT_PE_WORKSPACE_ENABLED=false

# Hard cap on workspace dispatches per UTC day. Counts every attempt
# (success / failure / stub) so a looping proposal can't chew the budget.
# Linear-delegated (webhook) dispatches skip this count cap; the USD cap
# below still applies to them.
AGENT_PE_WORKSPACE_MAX_PER_DAY=2

# Daily USD cap on container time + LLM cost across all PE dispatches;
# new dispatches are refused once the UTC day's total would exceed it.
AGENT_PE_WORKSPACE_DAILY_USD_CAP=3.00

# GitHub PAT for the PE workspace (pushes the agent sub-branch, opens the
# PR against `feat/agent-fleet`). Empty disables the real adapter. This
# value only gates the adapter and is not sent to the sandbox: the PAT
# the workspace uses lives in the Managed Agents vault below. Secret.
GITHUB_TOKEN=

# Managed Agents (beta) resource IDs, created once by the operator
# (console or a setup script) and referenced on every dispatch:
#   AGENT_PE_WORKSPACE_AGENT_ID        client.beta.agents.create(...):
#                                      PE model + agent toolset + GitHub
#                                      MCP server + PE system prompt
#   AGENT_PE_WORKSPACE_ENVIRONMENT_ID  client.beta.environments.create(...)
#   AGENT_PE_WORKSPACE_VAULT_ID        client.beta.vaults.create(...) +
#                                      vaults.credentials.create(...)
#                                      holding the GitHub PAT
AGENT_PE_WORKSPACE_AGENT_ID=
AGENT_PE_WORKSPACE_ENVIRONMENT_ID=
AGENT_PE_WORKSPACE_VAULT_ID=

# ============================================
# Pluggable PE worker backend (AFX-79)
# ============================================
# Routes PE dispatches to Claude Managed Agents (default) or Devin
# (Cognition Labs). Ships dark: without AGENT_PE_BACKEND=devin AND
# DEVIN_API_KEY set, behaviour is identical to the single-backend
# shape.

# Which worker backend PE dispatches to. One of:
#   managed_agents  Anthropic Managed Agents (default, zero behaviour
#                   change from pre-adapter).
#   devin           Cognition Labs' Devin — DEVIN_API_KEY + DEVIN_ORG_ID
#                   must be set or we fall back to stub with a warning.
# Unknown value → falls back to managed_agents with a warning.
AGENT_PE_BACKEND=managed_agents

# Optional per-label routing. Comma-separated `label:backend` pairs.
# When a dispatch's spec carries a matching label, that backend wins
# over AGENT_PE_BACKEND above. Unlisted labels fall through to the
# default. Example: UX:devin,Portal:devin,Validator:managed_agents
AGENT_PE_BACKEND_ROUTE=

# Devin Service Key (preferred over a Personal Access Token for
# programmatic clients; prefix `cog_...`). Empty disables Devin even
# if AGENT_PE_BACKEND=devin. Secret — never log.
DEVIN_API_KEY=

# Devin organization id from the Cognition dashboard URL. Required for
# POST /v3/organizations/{org_id}/sessions.
DEVIN_ORG_ID=

# Per-session ACU cap sent on sessions.create. 1 ACU ≈ 15 min of
# active Devin work; 10 ACU ≈ 2.5h of wall-clock. Belt-and-braces
# alongside the per-day USD cap.
DEVIN_MAX_ACU_PER_SESSION=10

# USD per ACU, used to convert `acu_consumed` from Devin's session
# payload into the `llm_usd` column on `agent_workspace_runs` for
# budget bookkeeping. Verify against Devin's actual PAYG rate at
# purchase; default is the Nov-2026 third-party figure.
DEVIN_ACU_USD_RATE=2.25

# ============================================
# Linear Triage filing (AFX-11)
# ============================================
# QA / PE / PM / Research findings are also filed as Linear Triage
# issues (deduped on `Fingerprint:`; a match gets a comment instead).
# Email notifications continue regardless. Dark by default.
AGENT_LINEAR_ENABLED=false

# API key of the fleet's dedicated Linear user, not Wilson's personal
# key, so attribution + `Source` labels are correct. Empty disables
# filing even with the flag on. Secret. (Separate from the
# LINEAR_AGENT_* OAuth app credentials below.)
LINEAR_API_KEY=

# Linear team key the fleet files into (single team today).
AGENT_LINEAR_TEAM_KEY=AFX

# Max NEW Triage issues per agent per UTC day. Comments on existing
# dedupe matches don't count toward the cap.
AGENT_LINEAR_DAILY_CAP_PER_AGENT=5

# ============================================
# PE Linear dispatch gates (2026-11-01)
# ============================================
# Linear state + label IDs the PE scan loop reads from / writes to.
# Defaults are the live IDs for the AFX team; override only for a
# fresh workspace or a dry-run environment. Pulled from the Linear
# API; see `agentfx/agents/fleet/linear_pe_queue.py`.

# State id (type=unstarted) that PE reads from (= "Ready").
PE_LINEAR_READY_STATE_ID=6e478120-c29c-4c74-948b-a57f3225793f

# State id PE transitions to on dispatch (= "In Progress"). Acts as
# the atomic lock so parallel scans don't double-dispatch.
PE_LINEAR_IN_PROGRESS_STATE_ID=7fcc84dc-1f85-44db-982a-03f6f89f3647

# Label id for `agent-filed` — PE only picks up issues carrying this
# label, so human-filed work is left alone.
PE_LINEAR_AGENT_FILED_LABEL_ID=2383c4d2-dc76-41d7-8e12-f903a37ce5cd

# Label id for `needs-wilson` — PE applies this + comments when a
# dispatch keeps failing with the same signature, or a session opens
# a `[NEEDS DESIGN]` PR.
PE_LINEAR_NEEDS_WILSON_LABEL_ID=28c066e1-70f6-41e5-8a64-8b0c7a9055d9

# Max new dispatches per PE scan tick. Keeps a backlog spike from
# fanning out all at once to Managed Agents.
PE_LINEAR_MAX_DISPATCH_PER_SCAN=3

# ============================================
# Linear Agent webhook receiver (AFX-66)
# ============================================
# When the PE is registered as a Linear Agent app user, Linear POSTs
# AgentSessionEvent webhooks to:
#   POST /api/v1/integrations/linear/agent-webhook
# on delegation / @mention / comment reply to an open session.
#
# Every delivery is verified + persisted to `linear_webhook_deliveries`.
# Since Phase 2, `created` / `prompted` events also hand the session to
# the PE workspace dispatcher (needs the AGENT_PE_WORKSPACE_* block
# above), which reports progress back as agent activities.
#
# Setup (do once, Linear admin):
#   1. Create an OAuth Application at
#      https://linear.app/settings/api/applications/new
#      Callback URL: https://<your-deployment>/api/v1/integrations/linear/oauth/callback
#   2. Enable webhooks, select "Agent session events".
#   3. Scopes: read, write, app:assignable, app:mentionable.
#      `write` is required for agentActivityCreate; comments:create /
#      issues:create alone fail with "Invalid scope: write required".
#   4. Webhook URL: https://<your-deployment>/api/v1/integrations/linear/agent-webhook
#   5. Install into the workspace with actor=app (admin-only; not
#      compatible with the `admin` scope). Set LINEAR_AGENT_CLIENT_ID /
#      _SECRET on the deployment first: the install only finalizes once
#      the step-1 callback exchanges the authorization code.
#
# LINEAR_AGENT_WEBHOOK_SECRET is on the Application's webhook detail
# page — never log it. LINEAR_AGENT_CLIENT_ID / _SECRET are used by the
# install callback and by the client_credentials grant that mints the
# actor=app tokens for outbound agentActivityCreate mutations.

# Master toggle. Defaults to false — flag off makes the webhook
# endpoint ACK 200 without processing (safe for dark-launch deploys).
LINEAR_AGENT_ENABLED=false

# HMAC-SHA256 signing secret from Linear's Application → Webhook
# detail page. Required when LINEAR_AGENT_ENABLED=true; missing
# secret with flag on returns 500 so misconfiguration fails loud.
LINEAR_AGENT_WEBHOOK_SECRET=

# OAuth client credentials for the Application (never log the secret).
# Required by the install callback and by the client-credentials grant
# used to obtain actor=app tokens.
LINEAR_AGENT_CLIENT_ID=
LINEAR_AGENT_CLIENT_SECRET=
