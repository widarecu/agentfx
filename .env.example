# Environment Configuration Template
# Copy this file to .env.{environment} and fill in the values
# Supported environments: development, test, staging, production
#
# For Docker development (make docker-up):
#   - Environment variables are set in docker-compose.yml, not .env files
#   - OANDA credentials are read from your shell: export OANDA_API_KEY=...
#   - DATABASE_URL uses 'postgres' hostname (Docker service name) instead of 'localhost'

# ============================================
# Environment Settings
# ============================================
ENVIRONMENT=development
DEBUG=true
TESTING=false


# ============================================
# Database Configuration (PostgreSQL)
# ============================================
# For local development: postgresql://user:password@localhost:5432/agentfx_dev
# For Docker: postgresql://agentfx:agentfx@postgres:5432/agentfx
DATABASE_URL=postgresql://agentfx:agentfx@localhost:5432/agentfx_dev

# ============================================
# Security
# ============================================
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-with-a-secure-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Fernet key for at-rest encryption of user OANDA credentials (US-019).
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# REQUIRED in staging/production/UAT. Never reuse across environments.
FERNET_KEY=

# ============================================
# CORS Configuration
# ============================================
# Comma-separated list of allowed origins
# IMPORTANT: Must include frontend origin (usually http://localhost:5173 for Vite)
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# ============================================
# OANDA API Configuration
# ============================================
# Get your API key from https://www.oanda.com/account/tpa/personal_token
# Use 'practice' for paper trading, 'live' for real trading
OANDA_ENV=practice
OANDA_API_KEY=your-oanda-api-key-here
OANDA_ACCOUNT_ID=your-oanda-account-id-here
OANDA_API_HOST=api-fxpractice.oanda.com
OANDA_STREAMING_HOST=stream-fxpractice.oanda.com

# ============================================
# Logging
# ============================================
LOG_LEVEL=INFO

# ============================================
# Candle Ingestion Worker
# ============================================
# INGESTION_ENABLED, BACKFILL_DAYS, CANDLE_INSTRUMENTS, and
# CANDLE_GRANULARITIES are intentionally NOT set here. They are governed
# by ONE source per execution surface (no shared file across surfaces):
#
#   1. pytest (host)        → forced false by tests/conftest.py
#                             (test-correctness invariant)
#   2. Local Docker dev/test → docker-compose.yml `environment:` block
#                             with `${VAR:-default}` shell substitution.
#                             Override at boot time, e.g.:
#                               make docker-up PROFILE=dev INGESTION_ENABLED=false
#                               CANDLE_INSTRUMENTS=EUR_USD CANDLE_GRANULARITIES=M1 \
#                                 make docker-up PROFILE=test INGESTION_ENABLED=true \
#                                                BACKFILL_DAYS=2190
#   3. Railway              → set in the Railway service-variables dashboard
#                             (image doesn't ship with .env files)
#
# Defaults baked into the Pydantic settings in
# `src/agentfx/api/core/config.py` apply when no env var is set on any
# surface. Putting these vars BACK into .env.{development,test} re-creates
# the shadow-confusion this layout was designed to eliminate — please don't.
# See CLAUDE.md → "Ingestion toggle: three-surface model" for the full
# rationale and command examples.

# Poll interval in seconds (default: 60)
INGESTION_POLL_INTERVAL=60

# Wilson UAT 2026-08-02: fold-anchored + bar-boundary ingestion.
# Two coupled timing knobs that determine how fresh candle data is by
# the time the paper runner evaluates a signal. Getting them wrong
# causes silent races → paper runner reads stale df → misses cross-
# event entries (see paper_runner.py Fix D history). Constraints:
#
#   INGESTION_ALIGNMENT_BUFFER_SECONDS < SIGNAL_TICK_OFFSET_SECONDS
#   SIGNAL_TICK_OFFSET_SECONDS > INGESTION_ALIGNMENT_BUFFER_SECONDS
#                                + observed ingestion cycle work (2-6s)
#
# Defaults align with observed OANDA behavior (bar available ~1s
# post-close). Timing budget for one M1 bar:
#   :00     bar closes
#   :03     ingester wakes (BUFFER=3)
#   :06-:09 ingester writes bar to DB (cycle work)
#   :10     signal tick fires (OFFSET=10)
#   :10.5   order placed → OANDA fill

# Seconds after each minute boundary to wake the ingestion loop.
# OANDA typically has closed bars available within ~1s of close;
# 3s buffer gives margin without wasted latency. Bump if OANDA's
# post-close latency ever grows.
INGESTION_ALIGNMENT_BUFFER_SECONDS=3

# Seconds after each granularity boundary to fire paper-run signal
# ticks. Must be > INGESTION_ALIGNMENT_BUFFER_SECONDS + typical
# ingestion cycle duration, so the just-closed bar is guaranteed to
# be in the DB when the runner evaluates.
SIGNAL_TICK_OFFSET_SECONDS=10

# Health check interval in seconds (gap detection/healing)
# Set to 0 to disable continuous health checks (only run at startup)
CANDLE_HEALTH_CHECK_INTERVAL=3600

# ============================================
# Agent / Evolution Loop Configuration (v0.3.0)
# ============================================
# Anthropic API key powers the LLM hypothesis-injection step in the
# autonomous strategy evolution loop. Get one at:
#   https://console.anthropic.com/settings/keys
# Without it, evolution runs proceed without LLM injection (GA-only).
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Per-run LLM budget cap (USD). Default applied when a POST
# /api/v1/evolution-runs request body doesn't override it. Prod default
# is 5.00; lower in non-prod to limit accidental spend.
EVOLUTION_LLM_BUDGET_USD=5.00

# Anthropic model alias. Valid: claude-sonnet-4-6 (default — balanced),
# claude-haiku-4-5 (cheap diversity variant), claude-opus-4-7 (max
# capability — for correctness-critical runs only).
EVOLUTION_LLM_MODEL=claude-sonnet-4-6

# ============================================
# Nightly Evolution Cron (Railway only)
# ============================================
# These env vars are consumed by scripts/trigger_nightly_evolution.py,
# which is invoked by the Railway cron declared in railway.toml. They
# are NOT needed for local development — only set them on the deployed
# Railway service.
#
# AGENTFX_BASE_URL=https://agentfx-staging.up.railway.app
# CRON_SERVICE_TOKEN=<service-account JWT or API key>
# CRON_INSTRUMENTS=EUR_USD,GBP_USD
# CRON_GRANULARITY=M1
# CRON_DATA_YEARS=5
# CRON_LLM_BUDGET_USD=5.00

# ============================================
# Notifications (v0.6.2)
# ============================================
# Slack incoming-webhook URL for paper-run terminal + crash alerts.
# Empty (default) disables all outbound notifications — the runner
# short-circuits at `_should_send` before any HTTP is attempted.
# Generate at:
#   Slack workspace → Apps → Incoming Webhooks → Add Configuration
# Keep secret; the URL IS the auth token.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../XXX

# Master on/off. Defaults to true; only override to explicitly silence
# notifications without unsetting the URL (e.g. a quiet weekend, a
# staging soak-test where the channel would get noisy).
# NOTIFICATIONS_ENABLED=true
