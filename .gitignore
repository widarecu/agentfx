.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.DS_Store
# Environment files with secrets (NEVER commit these)
.env
.env.development
.env.test
.env.uat
.env.staging
.env.production
.env.local
.env.*.local
.env.*.backup

# Keep example files tracked
!.env.example
!portal/web/.env.example
data/
*.log
*.log.*
*.db
*.sqlite
*.sqlite3

# Claude Code plans and settings
.claude/

# Symlink to portal/web/node_modules used by Playwright. The link target
# is already ignored above, but git lists the link itself as untracked
# unless we explicitly silence it.
tests/e2e/node_modules

# Screenshot artifacts from E2E tests (Playwright captures on failure automatically)
*.png

# Root package files (Playwright uses these, not for production)
/package.json
/package-lock.json

# Test results and coverage
.coverage
.pytest_cache/
htmlcov/
test-results/
test-data/
test_*.db
*_test.log

# Build and distribution
.tox/
dist/
build/
*.egg-info/
node_modules/
dist/

# NPM/Yarn debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local docker-compose overrides (LAN-IP overrides for phone access,
# per-developer resource limits, etc). docker compose auto-loads
# `docker-compose.override.yml` alongside `docker-compose.yml`.
docker-compose.override.yml
